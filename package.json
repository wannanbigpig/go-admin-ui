{
    "name": "x-l-admin-vue3",
    "version": "0.10.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.4.1",
    "engines": {
        "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
    },
    "description": "基于 Vue 3 + Vite + Element Plus 的后台管理系统",
    "keywords": [
        "vue3",
        "vite",
        "element-plus",
        "admin",
        "后台管理系统"
    ],
    "author": "",
    "license": "MIT",
    "scripts": {
        "local": "vite --mode location",
        "dev": "vite --mode development",
        "prod": "vite --mode production",
        "build:dev": "vite build --mode development",
        "build:production": "vite build --mode production",
        "type-check": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.json",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "preview": "vite preview",
        "prepare": "husky",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@element-plus/icons-vue": "^2.3.2",
        "@iconify/vue": "^5.0.1",
        "animate.css": "^4.1.1",
        "axios": "^1.20.0",
        "echarts": "^6.1.0",
        "element-plus": "^2.14.5",
        "js-sha256": "^1.0.0",
        "nprogress": "^0.2.0",
        "pinia": "^4.0.3",
        "pinia-plugin-persistedstate": "^4.7.1",
        "vue": "^3.5.42",
        "vue-i18n": "^11.4.10",
        "vue-router": "^5.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@iconify-json/ant-design": "^1.2.9",
        "@iconify-json/carbon": "^1.2.27",
        "@iconify-json/ep": "^1.2.4",
        "@iconify-json/lucide": "^1.2.131",
        "@playwright/test": "^1.63.0",
        "@types/node": "^22.20.2",
        "@types/nprogress": "^0.2.3",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vitest/coverage-v8": "^5.0.0",
        "@vue/test-utils": "^2.5.0",
        "eslint": "^10.10.0",
        "eslint-plugin-vue": "^10.11.0",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "jsdom": "^30.0.1",
        "lint-staged": "^17.5.1",
        "prettier": "^3.9.6",
        "sass": "^1.104.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0",
        "unplugin": "^3.3.0",
        "unplugin-auto-import": "^21.1.0",
        "unplugin-element-plus": "^0.11.2",
        "unplugin-icons": "^24.0.0",
        "unplugin-vue-components": "^32.1.0",
        "vite": "^8.3.0",
        "vite-plugin-compression": "^0.5.1",
        "vitest": "^5.0.0",
        "vue-tsc": "^3.3.11"
    }
}
