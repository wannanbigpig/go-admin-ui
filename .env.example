# ==================== 应用配置 ====================
# 应用标题（显示在浏览器标签页）
VITE_APP_TITLE=X-L-Admin

# 是否开启国际化
# true: 开启 / false: 关闭
VITE_ENABLE_I18N=true

# 默认语言
# zh-CN: 简体中文 / en-US: English
VITE_DEFAULT_LOCALE=zh-CN

# 应用基础路径（用于 GitHub Pages 部署，默认为 /）
# 如果部署到子目录，设置为 /仓库名/
VITE_APP_BASE=/

# ==================== API 配置 ====================
# 后端 API 基础地址
# 生产环境：填写完整的 API 地址，如 https://api.example.com
# 开发环境：留空使用本地代理
VITE_BASE_URL=https://admin-api.wannanbigpig.com/

# API 基础前缀
VITE_BASE_API=/admin

# 静态资源基础路径
VITE_BASE_STATIC=/static

# ==================== 代理配置 ====================
# 开发环境代理目标地址（本地后端服务）
VITE_PROXY_TARGET=http://127.0.0.1:9001

# 是否启用代理（开发环境建议启用，解决跨域问题）
# true: 启用代理 / false: 禁用代理
VITE_USE_PROXY=true

# ==================== 开发体验 ====================
# 开发环境是否自动打开浏览器
# true: 自动打开 / false: 不打开
AUTO_OPEN_BROWSER=true
