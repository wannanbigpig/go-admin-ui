# WebSocket mapping
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# Rate limiting zones
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=addr_limit:10m;

# HTTP to HTTPS redirect
server {
    listen 80;
    server_name 112.124.53.17;
    return 301 https://$host$request_uri;
}

server
{
    listen 443 ssl http2;
    ssl_certificate /etc/nginx/ssl/nginx.crt;
    ssl_certificate_key /etc/nginx/ssl/nginx.key;
    
    # HSTS configuration
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    server_name 112.124.53.17;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ws: wss: http: https:;" always;

    index index.html index.htm default.htm default.html;

    root /home/x-l-admin;

    include /www/server/panel/vhost/nginx/extension/112.124.53.17/*.conf;

    #CERT-APPLY-CHECK--START

    # 用于SSL证书申请时的文件验证相关配置 -- 请勿删除并保持这段设置在优先级高的位置

    include /www/server/panel/vhost/nginx/well-known/112.124.53.17.conf;

    #CERT-APPLY-CHECK--END

    #SSL-START SSL相关配置，请勿删除或修改下一行带注释的404规则

    #error_page 404/404.html;

    #SSL-END

    #ERROR-PAGE-START  错误页配置，可以注释、删除或修改

    #error_page 404 /404.html;

    #error_page 502 /502.html;

    #ERROR-PAGE-END

    #REWRITE-START URL重写规则引用,修改后将导致面板设置的伪静态规则失效

    include /www/server/panel/vhost/rewrite/html_112.124.53.17.conf;

    #REWRITE-END

    # ==================== 静态资源优先处理（必须在 location / 之前）====================
    # 重要：静态资源的 location 必须在 location / 之前，确保 JS/CSS 等文件返回正确内容
    # 使用正则匹配，优先级高于普通 location
    # 包含所有可能的静态资源扩展名
    location ~* \.(js|mjs|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|map|json)$
    {
        expires      12h;
        error_log /dev/null;
        access_log /dev/null;
        # 关键：文件不存在时返回 404，不要返回 index.html
        try_files $uri =404;
    }

    # 图片资源（更长的缓存时间）
    location ~* \.(gif|jpg|jpeg|png|bmp|swf|webp)$
    {
        expires      30d;
        error_log /dev/null;
        access_log /dev/null;
        # 关键：文件不存在时返回 404
        try_files $uri =404;
    }

    # ==================== Vue Router History 模式支持 ====================
    # ==================== API 反向代理（必须在 location / 之前）====================
    # 重要：否则 /admin 会被 location / 回退到 index.html，前端拿到 HTML 导致请求异常
    location ^~ /admin/
    {
        proxy_pass http://127.0.0.1:9001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        
        # Short timeout for regular APIs
        proxy_connect_timeout 60s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        
        # Rate limiting
        limit_req zone=api_limit burst=20 nodelay;
        limit_conn addr_limit 20;
    }

    # WebSocket specific location with long timeout
    location ^~ /admin/v1/common/ws
    {
        proxy_pass http://127.0.0.1:9001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        
        # Long timeout for WebSocket connections
        proxy_connect_timeout 60s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        
        # Rate limiting
        limit_req zone=api_limit burst=20 nodelay;
        limit_conn addr_limit 20;
    }

    location ^~ /static/
    {
        proxy_pass http://127.0.0.1:9001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_connect_timeout 60s;
    }

    # 支持 Vue Router History 模式
    # 所有请求都尝试查找文件，找不到则返回 index.html，让 Vue Router 处理路由
    # 注意：静态资源已经在上面处理了，这里不会匹配到静态资源
    location / {
        try_files $uri $uri/ /index.html;
    }

    #禁止访问的文件或目录

    location ~ ^/(\.user.ini|\.htaccess|\.git|\.env|\.svn|\.project|LICENSE|README.md)
    {
        return 404;
    }

    #一键申请SSL证书验证目录相关设置

    location ~ \.well-known{
        allow all;
    }

    #禁止在证书验证目录放入敏感文件

    if ( $uri ~ "^/\.well-known/.*\.(php|jsp|py|js|css|lua|ts|go|zip|tar\.gz|rar|7z|sql|bak)$" ) {
        return 403;
    }

    access_log  /www/wwwlogs/112.124.53.17.log;

    error_log  /www/wwwlogs/112.124.53.17.error.log;
}
